set_location_assignment PIN_U24 -to GPIO_1[25]
set_location_assignment PIN_R19 -to GPIO_1[26]
set_location_assignment PIN_T19 -to GPIO_1[27]
set_location_assignment PIN_U20 -to GPIO_1[28]
set_location_assignment PIN_U21 -to GPIO_1[29]
set_location_assignment PIN_V26 -to GPIO_1[30]
set_location_assignment PIN_V25 -to GPIO_1[31]
set_location_assignment PIN_V24 -to GPIO_1[32]
set_location_assignment PIN_V23 -to GPIO_1[33]
set_location_assignment PIN_W25 -to GPIO_1[34]
set_location_assignment PIN_W23 -to GPIO_1[35]

# ── RTL 소스 (TOP_SOC_MMIO_TEST 계층) ──
set_global_assignment -name VERILOG_FILE rtl/TOP_SOC_MMIO_TEST.v
set_global_assignment -name VERILOG_FILE rtl/huskylens_sensor_core.v
set_global_assignment -name VERILOG_FILE rtl/ov7670_lcm_wall_core.v
set_global_assignment -name VERILOG_FILE rtl/LCM_PLL.v
set_global_assignment -name VERILOG_FILE rtl/I2S_LCM_Config.v
set_global_assignment -name VERILOG_FILE rtl/I2S_Controller.v
set_global_assignment -name VERILOG_FILE rtl/UART_TX.v
set_global_assignment -name VERILOG_FILE rtl/UART_RX.v
set_global_assignment -name VERILOG_FILE rtl/TIMER.v
set_global_assignment -name VERILOG_FILE rtl/RV32I.v
set_global_assignment -name VERILOG_FILE rtl/REGFILE.v
set_global_assignment -name VERILOG_FILE rtl/PC.v
set_global_assignment -name VERILOG_FILE rtl/MAINDEC.v
set_global_assignment -name VERILOG_FILE rtl/IMEM.v
set_global_assignment -name VERILOG_FILE rtl/HL_PARSER.v
set_global_assignment -name VERILOG_FILE rtl/EXTEND.v
set_global_assignment -name VERILOG_FILE rtl/DMEM_MMIO.v
set_global_assignment -name VERILOG_FILE rtl/DATAPATH.v
set_global_assignment -name VERILOG_FILE rtl/CONTROLLER.v
set_global_assignment -name VERILOG_FILE rtl/ALUDEC.v
set_global_assignment -name VERILOG_FILE rtl/ALU.v
set_global_assignment -name CDF_FILE output_files/Chain3.cdf

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top